<style>

    body{
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: var(--lavanda-claro);
        color: var(--preto);
    }
    header{
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }
    h1{
        font-family: 'Anton', sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: 4rem;
    text-align: center;
    letter-spacing: 2px;
    color: var(--vermelho);
    text-shadow:
        -3px -3px 0 var(--preto),
        3px -3px 0 var(--preto),
        -3px 3px 0 var(--preto),
        3px 3px 0 var(--preto),
        6px 6px 0 var(--roxo-escuro);
    transform: skewX(-5deg);
    margin: 0.5rem 0;
    }
    .ct{
        display: flex;
        justify-content: end;
        font-size: 50px;
    }

    .btn{
        padding: 1rem 2rem;
        font-size: 1.5rem;
        background-color: var(--vermelho);
        color: var(--branco);
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }
    .btn:hover{
        background-color: var(--vermelho-escuro);
    }

    .sobre{
        text-align: center;
        font-size: 1.5rem;
        margin-bottom: 2rem;
        background-color: var(--cinza-claro);
        color: var(--preto);
        font-family:'Times New Roman', Times, serif
    }
    .genero{
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
        
    }

    .generos{
        padding: 0.5rem 1rem;
        font-size: 1rem;
        background-color: var(--roxo);
        color: var(--branco);
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }
    .generos:hover{
        background-color: var(--roxo-escuro);
    }
    .filme{
        display:grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap:1.5rem;
        max-width: 75rem;
        width: 100%;
        padding: 2rem;
        box-sizing: border-box;
        font-size: 20px;
    }

    .movie{
        width: 100%;
        border: 1px solid var(--cinza);
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        color: black;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s;
        background-color: var(--branco);
    }

    .movie:hover{
        transform: translateY(-8px) scale(1.05);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.35);
    }

    .movie img{
    width: 100%;
    height: 280px;
    object-fit: cover;
    object-position: center top;
    display: block;
    }

    h3{
        text-align: center;
        font-size: 1.5rem;
        margin: 0.5rem 0;
    }

    .description{
        text-align: center;
        font-size: 0.95rem;
        margin: 0.5rem 0;
    }
    .categoria{
        background-color: var(--vermelho);
        color: var(--branco);
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 5px;
        text-align: end;
     
    }
    footer{
        background-color: var(--preto);
        color: var(--cinza-claro);
        text-align: center;
        padding: 30px 20px;
    }

    footer a{
        color: var(--lavanda);
        margin: 0 10px;
        text-decoration: none;
    }

    :root{
    --preto: #1a1a1a;
    --branco: #ffffff;
    --cinza-claro: #e8e8e8;
    --cinza: #6b6b6b;
    --roxo-escuro: #3d0a5c;
    --roxo: #6a0dad;
    --lavanda: #b19cd9;
    --lavanda-claro: #e6dcf5;
    --vermelho: #d90429;
    --vermelho-escuro: #8a0303;
    }
</style>
</body>
</html>
